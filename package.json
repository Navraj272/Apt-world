{
  "name": "casino-admin",
  "version": "1.0.0",
  "description": "Admin Backend structure for the app",
  "main": "index.js",
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.6.7"
  },
  "scripts": {
    "start": "node ./dist/index",
    "start:dev": "nodemon --exec npm run babel-node -- ./index.js",
    "watch": "./node_modules/.bin/nodemon ./bin",
    "migrate:undo": "sequelize db:migrate:undo",
    "sequelize": "npm run babel-node node_modules/.bin/sequelize",
    "db:reset": "npm run build && sequelize db:drop && sequelize db:create && sequelize db:migrate && sequelize db:seed:all",
    "db:setup": "npm run build && sequelize db:create && sequelize db:migrate && sequelize db:seed:all",
    "db:seed": "npm run build && sequelize db:seed:all",
    "db:migrate": "npm run build && sequelize db:migrate",
    "prod:db:reset": "sequelize db:drop && sequelize db:create && sequelize db:migrate && sequelize db:seed:all",
    "seed": "sequelize db:seed:all",
    "migrate": "sequelize db:migrate",
    "lint": "standard --fix",
    "babel-node": "babel-node --inspect=0.0.0.0:9229",
    "build": "babel . -d dist",
    "test": "jest --reporters=default --reporters=jest-html-reporter --forceExit"
  },
  "author": "true IGtech",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "3.688.0",
    "@aws-sdk/lib-storage": "3.504.0",
    "@babel/plugin-syntax-flow": "7.18.6",
    "@faker-js/faker": "9.2.0",
    "@sendgrid/mail": "^8.1.4",
    "@socket.io/redis-adapter": "7.2.0",
    "@socket.io/redis-emitter": "5.1.0",
    "ajv": "8.8.2",
    "ajv-formats": "2.1.1",
    "ajv-i18n": "4.2.0",
    "ajv-keywords": "5.1.0",
    "babel-node": "0.0.1-security",
    "babel-plugin-module-resolver": "5.0.2",
    "bcrypt": "5.0.1",
    "convict": "6.2.4",
    "cookie-parser": "1.4.7",
    "cloudinary": "^1.41.3",
    "cors": "2.8.5",
    "crypto-js": "4.2.0",
    "dayjs": "1.11.10",
    "esdk-obs-nodejs": "3.23.11",
    "express": "^4.21.2",
    "flatted": "3.2.4",
    "form-data": "4.0.1",
    "helmet": "6.0.1",
    "http-status-codes": "2.2.0",
    "i18n": "^0.15.1",
    "ioredis": "5.3.1",
    "js-yaml": "4.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "9.0.2",
    "lodash": "4.17.21",
    "mailgun.js": "10.2.0",
    "mathjs": "13.2.2",
    "md5": "2.3.0",
    "morgan": "1.10.0",
    "multer": "1.4.4-lts.1",
    "nodemailer": "^6.9.16",
    "node-mailjet": "6.0.6",
    "node-xlsx": "0.4.0",
    "pg": "8.6.0",
    "pg-hstore": "2.3.4",
    "pino": "9.5.0",
    "pino-pretty": "11.3.0",
    "pluralize": "^8.0.0",
    "reflect-metadata": "0.1.13",
    "rimraf": "4.4.1",
    "sequelize": "6.37.5",
    "sequelize-cli": "6.6.1",
    "sharp": "0.33.5",
    "socket.io": "4.8.1",
    "ssh2-sftp-client": "9.0.4",
    "uuid": "11.0.5"
  },
  "devDependencies": {
    "@babel/cli": "7.16.0",
    "@babel/core": "7.16.5",
    "@babel/eslint-parser": "7.16.5",
    "@babel/node": "7.16.5",
    "@babel/preset-env": "7.16.5",
    "@babel/register": "7.25.9",
    "dotenv": "10.0.0",
    "eslint": "7.12.1",
    "jest": "^29.7.0",
    "jest-html-reporter": "^4.1.0",
    "lint-staged": "12.1.2",
    "nodemon": "3.1.7",
    "standard": "16.0.4",
    "supertest": "^7.0.0"
  },
  "standard": {
    "parser": "@babel/eslint-parser",
    "env": {
      "jest": true,
      "browser": true,
      "node": true
    }
  },
  "lint-staged": {
    "src/**/*.js": [
      "npm run lint"
    ]
  }
}
